  19 0004 598F      		subq.l	#4, %sp                 
  20               		* スタック上に 1文字分のバッファ領域 (4バイト確保, 先頭 %sp) を作成
  21               	
  22               	inbyte_retry:
  23               	    *trap #0のための準備とtrap #0
  24 0006 7001      		move.l	#1, %d0                 | システムコール番号 1 =GETSTRING
  25 0008 7200      		move.l	#0, %d1                 | ch = 0 (UART1)
  26 000a 240F      		move.l	%sp, %d2                | 書き込み先バッファアドレス = スタック上の領
  27 000c 7601      		move.l	#1, %d3                 | 最大 1 文字取得
  28 000e 4E40      		trap	#0                      | getstringシステムコール呼び出し (戻り値: %D0.L = 取
  29               	
  30               		* 受信キューが空 (取得文字数 == 0) の場合は、1文字入るまでd0.lに何か入
  31               		* (GETSTRING は入力待ちをせず 0 を返す仕様のため)
  32 0010 0C80 0000 		cmpi.l	#1, %d0
  32      0001 
  33 0016 6600 FFEE 		bne	inbyte_retry
  34               	
  35               		* バッファに格納された受信1文字 (1バイト) を %D0 の下位バイトへ読み出
  36               		* 上位ビットにゴミが残らないようゼロ拡張しておく
  37 001a 7000      		moveq.l	#0, %d0
  38 001c 1017      		move.b	(%sp), %d0
  39               	
  40               		* スタック領域の解放と、退避したレジスタ (%D1-%D3) の復元
  41               		* さっきの4バイト解法
  42 001e 588F      		addq.l	#4, %sp
  43 0020 4CDF 000E 		movem.l	(%sp)+, %d1-%d3
  44 0024 4E75      		rts
