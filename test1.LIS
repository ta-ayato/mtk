 602               	** INTERPUT(ch) : 送信割り込み処理 (Step 4, 3.8.1 節 p.33)
 603               	**   【入力】  %D1.L = チャネル ch
 604               	**   【戻り値】なし
 605               	**   【処理内容】p.33 の (1)〜(5)．キューが空なら送信割り込みをマスク．
 606               	**              UTX1 への書き込みでは上位 8bit のヘッダを忘れずに．
 607               	***************************************************************
 608               	INTERPUT:
 609 02ec 40E7      		move.w %SR, -(%SP)
 610 02ee 46FC 2700 		move.w #0x2700, %sr /* 割り込み禁止に */
 611               	
