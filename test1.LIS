 618 0302 4EBA FF44 	    jsr OUTQ /* 成功不成功はd0へ */
 619               	    
 620 0306 0C80 0000 	    cmpi.l #0, %d0
 620      0000 
 621 030c 6700 0016 	    beq INTERPUT_MASK
 622               	
