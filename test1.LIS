  70 003a 6700 000A 		beq	inkey_no_input
  71               	
  72               		** 1文字取得できた場合は、符号なし 32bit 値 (0x00000000〜0x000000ff) として %d
  73 003e 7000      		moveq.l	#0, %d0
  74 0040 1017      		move.b	(%sp), %d0
