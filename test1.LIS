 623      00FF 
 624 0316 0041 0800 	    ori.w #0x0800, %d1 /* 上位8ビット制御ビット　フロー制御は行わない */	| [
 625 031a 33C1 00FF 	    move.w %d1, UTX1
 625      F906 
