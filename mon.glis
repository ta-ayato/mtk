   1               	***************************************************************
   2               	** simple_os.s : 簡易 OS + Step 9 エコーバックプログラム（班の提出物）
   3               	**   アセンブル: m68k-as -t 400 simple_os.s
   4               	**
   5               	**   簡易 OS 部分を 1 ファイルにまとめたもの (テキスト付録 A.6.3.2)．
   6               	**   以下の順に並んでいる (各部分は begin / end の行で区切ってある):
   7               	**     os_defs.s      定数 (レジスタのアドレス，システムコール番号など)
   8               	**     os_init.s      初期化 (boot を 0x400 番地に置くため先頭に置く)
   9               	**     user_echo.s    Step 9 のユーザプログラム (エコーバック + タイマ)
  10               	**     os_interface.s 割り込み・システムコールのインタフェース
  11               	**     os_queue.s     キュー
  12               	**     os_uart.s      送受信制御部
  13               	**     os_timer.s     タイマ制御部
  14               	***************************************************************
  15               	| ======== begin os_defs.s ========
  16               	***************************************************************
  17               	** os_defs.s : 定数定義（レジスタのアドレス・システムコール番号など）
  18               	**   コードは含まない．すべてのエントリファイルの最初に .include する．
  19               	**   出典: テキスト 3.5 節 (p.29), 3.13 節 (p.46), 付録 A.4.3 (p.57-58)
  20               	***************************************************************
  21               	
  22               	***************
  23               	** レジスタ群の先頭
  24               	***************
  25               		.equ REGBASE,   0xFFF000          | DMAP を使用．
  26               		.equ IOBASE,    0x00d00000
  27               	
  28               	***************
  29               	** 割り込み関係のレジスタ (付録 B.3.1)
  30               	***************
  31               		.equ IVR,       REGBASE+0x300     | 割り込みベクタレジスタ
  32               		.equ IMR,       REGBASE+0x304     | 割り込みマスクレジスタ
  33               		.equ ISR,       REGBASE+0x30c     | 割り込みステータスレジスタ
  34               		.equ IPR,       REGBASE+0x310     | 割り込みペンディングレジスタ
  35               	
  36               	***************
  37               	** タイマ関係のレジスタ (付録 B.3.2)
  38               	***************
  39               		.equ TCTL1,     REGBASE+0x600     | タイマ１コントロールレジスタ
  40               		.equ TPRER1,    REGBASE+0x602     | タイマ１プリスケーラレジスタ
  41               		.equ TCMP1,     REGBASE+0x604     | タイマ１コンペアレジスタ
  42               		.equ TCN1,      REGBASE+0x608     | タイマ１カウンタレジスタ
  43               		.equ TSTAT1,    REGBASE+0x60a     | タイマ１ステータスレジスタ
  44               	
  45               	***************
  46               	** UART1（送受信）関係のレジスタ (付録 B.3.3)
  47               	***************
  48               		.equ USTCNT1,   REGBASE+0x900     | UART1 ステータス/コントロールレジスタ
  49               		.equ UBAUD1,    REGBASE+0x902     | UART1 ボーコントロールレジスタ
  50               		.equ URX1,      REGBASE+0x904     | UART1 受信レジスタ
  51               		.equ UTX1,      REGBASE+0x906     | UART1 送信レジスタ
  52               	
  53               	***************
  54               	** LED・スイッチ (付録 A.4.3)
  55               	***************
  56               		.equ LED7,      IOBASE+0x000002f  | ボード搭載の LED 用レジスタ
  57               		.equ LED6,      IOBASE+0x000002d  | 左から LED7 〜 LED0
68K GAS  mon.s 			page 2


  58               		.equ LED5,      IOBASE+0x000002b
  59               		.equ LED4,      IOBASE+0x0000029
  60               		.equ LED3,      IOBASE+0x000003f
  61               		.equ LED2,      IOBASE+0x000003d
  62               		.equ LED1,      IOBASE+0x000003b
  63               		.equ LED0,      IOBASE+0x0000039
  64               		.equ PUSHSW,    0xFFF419          | 押しボタンスイッチ（下位 4bit，押すと 0）
  65               		.equ TOGGLESW,  0xD00041          | トグルスイッチ 8 個
  66               	
  67               	***************
  68               	** システムコール番号 (3.12.1 節 p.44)
  69               	***************
  70               		.equ SYSCALL_NUM_GETSTRING,   1
  71               		.equ SYSCALL_NUM_PUTSTRING,   2
  72               		.equ SYSCALL_NUM_RESET_TIMER, 3
  73               		.equ SYSCALL_NUM_SET_TIMER,   4
  74               	
  75               	***************
  76               	** キュー番号 (3.4.1 節 p.24: 受信 = 0 番，送信 = 1 番)
  77               	***************
  78               		.equ QNO_RECV,  0
  79               		.equ QNO_SEND,  1
  80               	
  81               	***************
  82               	** キューの制御変数のオフセット (表 3.2, os_queue.s の Q0_INFO / Q1_INFO からの�
  83               	***************
  84               		.equ TOP,     0
  85               		.equ BOTTOM,  4
  86               		.equ OUT,     8
  87               		.equ IN,      12
  88               		.equ S,       16
  89               	| ======== end os_defs.s ========
  90               	| ======== begin os_init.s ========
  91               	***************************************************************
  92               	** os_init.s : 初期化ルーチン (Step 1〜)
  93               	**   担当: 初期化（神井，副田）
  94               	**   レビュー: タイマ担当（松岡）
  95               	**
  96               	**   エントリファイルでは os_defs.s の直後に .include すること．
  97               	**   boot が .text の先頭 = 0x400 番地に置かれる必要がある (付録 A.1.1.3)．
  98               	**   以下の boot はテキスト 3.5 節 (p.29-30) のコードそのまま．
  99               	***************************************************************
 100               	
 101               	***************************************************************
 102               	** スタック領域の確保
 103               	***************************************************************
 104               	.section .bss
 105               	.even
 106               	SYS_STK:
 107 0000 0000 0000 		.ds.b	0x4000          | システムスタック領域
 107      0000 0000 
 107      0000 0000 
 107      0000 0000 
 107      0000 0000 
 108               		.even
 109               	SYS_STK_TOP:                | システムスタック領域の最後尾
 110               	
68K GAS  mon.s 			page 3


 111               	***************************************************************
 112               	** 初期化
 113               	** 内部デバイスレジスタには特定の値が設定されている．
 114               	** その理由を知るには，付録 B にある各レジスタの仕様を参照すること．
 115               	***************************************************************
 116               	.extern start
 117               	.global monitor_begin
 118               	
 119               	.section .text
 120               	.even
 121               	monitor_begin: **ハードウェア初期化開始位置
 122               	boot:
 123               		* スーパーバイザ & 各種設定を行っている最中の割込禁止
 124 0000 46FC 2700 		move.w	#0x2700,%SR	| [レビュー: 松岡] S=1 (スーパーバイザ)，割り込みレベル 7 
 125 0004 4FF9 0000 		lea.l	SYS_STK_TOP,%SP         | Set SSP
 125      0000 
 126               	
 127               		****************
 128               		** 割り込みベクタの設定
 129               		** 表 B.4 (p.72) を見て，使う例外のベクタに処理ルーチンの
 130               		** 先頭アドレスを書き込む (B.2.4 の move.l #..., 0x110)．
 131               		****************
 132               		| [レビュー: 松岡] IVR=0x40 なのでレベル n の割り込みはベクタ番号 0x40+n，
 133 000a 21FC 0000 		move.l	#UART1_INTERRUPT, 0x110 	| レベル 4 (UART1), (64+4)*4
 133      0000 0110 
 134 0012 21FC 0000 		move.l	#SYSCALL_IF, 0x080			| TRAP #0, (32+0)*4
 134      0000 0080 
 135 001a 21FC 0000 		move.l	#TIMER1_INTERRUPT, 0x118	| レベル 6 (タイマ1), (64+6)*4
 135      0000 0118 
 136               	
 137               		****************
 138               		** 割り込みコントローラの初期化
 139               		****************
 140 0022 13FC 0040 		move.b	#0x40, IVR              | ユーザ割り込みベクタ番号を
 140      00FF F300 
 141               		                                | 0x40+level に設定．
 142 002a 23FC 00FF 		move.l	#0x00ffffff,IMR         | 全割り込みマスク
 142      FFFF 00FF 
 142      F304 
 143               	
 144               		****************
 145               		** 送受信 (UART1) 関係の初期化 (割り込みレベルは 4 に固定されている)
 146               		****************
 147 0034 33FC 0000 		move.w	#0x0000, USTCNT1        | リセット
 147      00FF F900 
 148 003c 33FC E100 		move.w	#0xe100, USTCNT1        | 送受信可能, パリティなし, 1 stop, 8 bit,
 148      00FF F900 
 149               		                                | 送受割り込み禁止
 150 0044 33FC 0038 		move.w	#0x0038, UBAUD1         | baud rate =  230400 bps
 150      00FF F902 
 151               	
 152               		****************
 153               		** タイマ関係の初期化 (割り込みレベルは 6 に固定されている)
 154               		****************
 155 004c 33FC 0004 		move.w	#0x0004, TCTL1          | restart, 割り込み不可,
 155      00FF F600 
 156               		                                | システムクロックの 1/16 を単位として計時，
68K GAS  mon.s 			page 4


 157               		                                | タイマ使用停止
 158               	
 159               		****************
 160               		** キューの初期化
 161               		** os_queue.s の QUEUE_INIT を呼ぶ．
 162               		****************
 163 0054 4EBA 012A 		jsr	QUEUE_INIT	| [レビュー: 松岡] 割り込みを許可する前にキューを初期化し�
 164               	
 165               		****************
 166               		** 割り込みの許可
 167               		** IMR で使う割り込みを許可し，走行レベルを下げる
 168               		**       (3.6 節 p.31 の 4 つの準備，B.3.4 の推奨値)．
 169               		****************
 170 0058 33FC E108 		move.w	#0xe108, USTCNT1	| [レビュー: 松岡] 受信割り込みだけ許可．送信割り込�
 170      00FF F900 
 171 0060 23FC 00FF 		move.l	#0xff3ff9, IMR	| [レビュー: 松岡] bit1 (タイマ1) と bit2 (UART1) を 0 にして�
 171      3FF9 00FF 
 171      F304 
 172 006a 46FC 2000 		move.w	#0x2000, %SR	| [レビュー: 松岡] スーパーバイザのまま走行レベルを 0 �
 173               	
 174               		** crt0.sの処理継続に戻る
 175 006e 4EF9 0000 		jmp start
 175      0000 
 176               		**bra	MAIN                    | ユーザプログラム / テストプログラムへ
 177               	
 178               	| ======== end os_init.s ========
 179               	| ======== begin user_echo.s ========
 180               	***************************************************************
 181               	** user_echo.s : Step 9 のユーザプログラム（エコーバック + タイマ）
 182               	**   テキスト 3.13.1 節 (p.46-47) のコードそのまま．
 183               	**   システムコールの番号は os_defs.s で定義済み．
 184               	**   確認すること (3.13.2 節): キー入力がエコーバックされる．
 185               	**   5 秒ごとに ****** が表示され改行，5 回で終了．
 186               	***************************************************************
 187               	
 188               	****************************************************************
 189               	*** プログラム領域
 190               	****************************************************************
 191               	.section .text
 192               	.even
 193               	MAIN:
 194               		** 走行モードとレベルの設定 (「ユーザモード」への移行処理)
 195 0074 46FC 0000 		move.w	#0x0000, %SR            | USER MODE, LEVEL 0
 196 0078 4FF9 0000 		lea.l	USR_STK_TOP,%SP         | user stack の設定
 196      0000 
 197               	
 198               		** システムコールによる RESET_TIMER の起動
 199 007e 7003      		move.l	#SYSCALL_NUM_RESET_TIMER,%D0
 200 0080 4E40      		trap	#0
 201               	
 202               		** システムコールによる SET_TIMER の起動
 203 0082 7004      		move.l	#SYSCALL_NUM_SET_TIMER, %D0
 204 0084 323C C350 		move.w	#50000, %D1
 205 0088 243C 0000 		move.l	#TT,    %D2
 205      0000 
 206 008e 4E40      		trap	#0
 207               	
68K GAS  mon.s 			page 5


 208               	******************************
 209               	* sys_GETSTRING, sys_PUTSTRING のテスト
 210               	* ターミナルの入力をエコーバックする
 211               	******************************
 212               	LOOP:
 213 0090 7001      		move.l	#SYSCALL_NUM_GETSTRING, %D0
 214 0092 7200      		move.l	#0,   %D1               | ch   = 0
 215 0094 243C 0000 		move.l	#BUF, %D2               | p    = #BUF
 215      0000 
 216 009a 263C 0000 		move.l	#256, %D3               | size = 256
 216      0100 
 217 00a0 4E40      		trap	#0
 218               	
 219 00a2 2600      		move.l	%D0, %D3                | size = %D0 (length of given string)
 220 00a4 7002      		move.l	#SYSCALL_NUM_PUTSTRING, %D0
 221 00a6 7200      		move.l	#0, %D1                 | ch = 0
 222 00a8 243C 0000 		move.l	#BUF,%D2                | p  = #BUF
 222      0000 
 223 00ae 4E40      		trap	#0
 224 00b0 6000 FFDE 		bra	LOOP
 225               	
 226               	******************************
 227               	* タイマのテスト
 228               	* '******' を表示し改行する．
 229               	* ５回実行すると，RESET_TIMER をする．
 230               	******************************
 231               	TT:
 232 00b4 48E7 FFFE 		movem.l	%D0-%D7/%A0-%A6,-(%SP)
 233 00b8 0C79 0005 		cmpi.w	#5,TTC                  | TTC カウンタで 5 回実行したかどうか数える
 233      0000 0000 
 234 00c0 6700 001C 		beq	TTKILL                  | 5 回実行したら，タイマを止める
 235               	
 236 00c4 7002      		move.l	#SYSCALL_NUM_PUTSTRING,%D0
 237 00c6 7200      		move.l	#0,    %D1              | ch = 0
 238 00c8 243C 0000 		move.l	#TMSG, %D2              | p  = #TMSG
 238      0000 
 239 00ce 7608      		move.l	#8,    %D3              | size = 8
 240 00d0 4E40      		trap	#0
 241               	
 242 00d2 0679 0001 		addi.w	#1,TTC                  | TTC カウンタを 1 つ増やして
 242      0000 0000 
 243 00da 6000 0006 		bra	TTEND                   | そのまま戻る
 244               	TTKILL:
 245 00de 7003      		move.l	#SYSCALL_NUM_RESET_TIMER,%D0
 246 00e0 4E40      		trap	#0
 247               	TTEND:
 248 00e2 4CDF 7FFF 		movem.l	(%SP)+,%D0-%D7/%A0-%A6
 249 00e6 4E75      		rts
 250               	
 251               	****************************************************************
 252               	*** 初期値のあるデータ領域
 253               	****************************************************************
 254               	.section .data
 255               	TMSG:
 256 0000 2A2A 2A2A 		.ascii	"******\r\n"             | \r: 行頭へ (キャリッジリターン)
 256      2A2A 0D0A 
 257               		.even                           | \n: 次の行へ (ラインフィード)
68K GAS  mon.s 			page 6


 258               	TTC:
 259 0008 0000      		.dc.w	0
 260               		.even
