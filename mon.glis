 275               	***************************************************************
 276               	** os_interface.s : 割り込みインタフェース・システムコールインタフェース
 277               	**   担当: 初期化（神井，副田）
 278               	**   レビュー: タイマ担当（松岡）
 279               	**
 280               	**   ここに置くルーチンは割り込み (例外) で起動されるので，rts ではな�
 281               	**   各ルーチンの先頭アドレスは os_init.s でベクタに登録する (表 B.4 p.72)�
 282               	***************************************************************
 283               	
 284               	.section .text
 285               	.even
 286               	
 287               	***************************************************************
 288               	** UART1_INTERRUPT : 送受信割り込み用のハードウェア割り込みインタフェース
 289               	**   (Step 4: 3.8.2 節 p.34 の (1)(2),  Step 6: 3.10.3 節 p.39 の (3)〜(6))
 290               	**   レベル 4 (UART1) のベクタに登録する．
 291               	**   【注意】UTX1 / URX1 は一度読むと更新されるので，別レジスタにコピー�
 292               	***************************************************************
 293               	UART1_INTERRUPT:
 294               	
 295               	    * D0~D3の元の値を保存 (複数レジスタは movem でまとめて積む)
 296 00e8 48E7 F000 	    movem.l %D0-%D3, -(%SP)	| [レビュー: 松岡] 割り込みはどこで起きるか分から�
 297               	
 298               	    ******** 送信 (Step 4) ********
 299               	    * UTX1の内容を取得
 300 00ec 3039 00FF 	    move.w UTX1, %D0
 300      F906 
 301               	
 302               	    * bit15だけを取り出す
 303 00f2 0240 8000 	    andi.w #0x8000, %D0	| [レビュー: 松岡] UTX1 の bit15 (FIFO EMPTY) が 1 なら送信で�
 304               	
 305               	    * bit15が0なら送信処理を行わない
68K GAS  mon.s 			page 7


 306 00f6 6700 0008 	    beq NOT_SEND
 307               	
 308               	    * INTERPUTにUART1のチャネル番号0を渡す
 309 00fa 7200      	    move.l #0x0000, %D1
 310               	
 311               	    * 送信担当のINTERPUTを呼び出す
 312 00fc 4EBA 01EE 	    jsr INTERPUT
 313               	
 314               	NOT_SEND:
 315               	
 316               	    ******** 受信 (Step 6) ********
 317               	    * URX1の内容を取得 (一度読むと更新されるので，以降はD3のコピーを使�
 318 0100 3639 00FF 	    move.w URX1, %D3
 318      F904 
 319               	
 320               	    * bit13 (DATA READY) を調べる (btst は D3 を壊さない)
 321 0106 0803 000D 	    btst #13, %D3	| [レビュー: 松岡] URX1 の bit13 (DATA READY) が 1 なら受信データ�
 322               	
 323               	    * bit13が0なら受信処理を行わない
 324 010a 6700 000A 	    beq NOT_RECEIVE
 325               	
 326               	    * INTERGETにチャネル番号0と受信データ (URX1の下位8bit) を渡す
 327 010e 7200      	    move.l #0x0000, %D1
 328 0110 1403      	    move.b %D3, %D2
 329               	
 330               	    * 受信担当のINTERGETを呼び出す
 331 0112 4EBA 027C 	    jsr INTERGET
 332               	
 333               	NOT_RECEIVE:
 334               	
 335               	    * D0~D3を元の値に復元 (退避と同じ組)
 336 0116 4CDF 000F 	    movem.l (%SP)+, %D0-%D3
 337               	
 338               	    * 割り込み前の処理に復帰
 339 011a 4E73      	    rte
