 713               	**   【入力】  %D1.L = ch,  %D2.L = 書き込み先アドレス p,  %D3.L = データ数 size
 714               	**   【戻り値】%D0.L = 実際に取り出したデータ数 sz
 715               	**   【処理内容】p.38 の (1)〜(9)．
 716               	***************************************************************
 717               	GETSTRING:
 718 03ac 48E7 7880 	    movem.l %d1-%d4/%a0, -(%sp)         /*作業用レジスタの退避 (%D0は戻り値のため�
 719               	
 720               	    /*(1) ch ≠ 0 ならば何もせず終了 (戻り値 0 で終了)*/
 721 03b0 0C81 0000 	    cmpi.l  #0, %d1
 721      0000 
 722 03b6 6600 002A 	    bne     GETSTRING_ERR
 723               	
 724               	    /*(2) sz ← 0 (%D4.L を sz として使用)，i ← p (%A0 を i として使用)*/
 725 03ba 7800      	    moveq.l #0, %d4                     /*sz = 0*/
 726 03bc 2042      	    movea.l %d2, %a0                    /*i = p*/
 727               	
 728               	GETSTRING_LOOP:
 729               	    /*(3) sz == size ならば (9) へ*/
 730 03be B883      	    cmp.l   %d3, %d4
 731 03c0 6700 001A 	    beq     GETSTRING_DONE
 732               	
 733               	    /*(4) OUTQ(0, data) により受信キュー(0番)から 8bit データ data を取り出す*/
