 735 03c6 4EBA FE80 	    jsr     OUTQ                        /*戻り値: %D0.L = 0 or 1, %D1.B = data*/	| [レビュー
 736               	
 737               	    /*(5) OUTQ の復帰値 (%D0) が 0 ならば (9) へ*/
 738 03ca 0C80 0000 	    cmpi.l  #0, %d0
 738      0000 
 739 03d0 6700 000A 	    beq     GETSTRING_DONE
 740               	
 741               	    /*(6) アドレス i で始まる領域に data をコピー ＆ (7) sz++, i++*/
 742 03d4 10C1      	    move.b  %d1, (%a0)+                 /*:m[i] = data, i++*/	| [レビュー: 田邉] ポストイ
 743 03d6 5284      	    addq.l  #1, %d4                     /*sz++*/
 744               	
 745               	    /*(8) (3) へ戻る*/
 746 03d8 6000 FFE4 	    bra     GETSTRING_LOOP
 747               	
 748               	GETSTRING_DONE:
 749               	    /* (9) %D0 ← sz として終了*/
 750 03dc 2004      	    move.l  %d4, %d0
 751 03de 6000 0004 	    bra     GETSTRING_EXIT
 752               	
 753               	GETSTRING_ERR:
 754 03e2 7000      	    moveq.l #0, %d0                     /*ch ≠ 0 の場合は 0 を返す*/
 755               	
 756               	GETSTRING_EXIT:
