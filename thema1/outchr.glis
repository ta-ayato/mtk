   6               	***************************************************************
   7               	** outbyte : 1文字出力関数 (C側 write() から呼び出し)
   8               	**   【引数】  4(%sp).L : 出力文字 (char型を32bitに拡張してpush, 下位1バイトが
   9               	**   【戻り値】なし
  10               	**   【使用 syscall】PUTSTRING (= 2)
  11               	**     入力: %D1.L = ch (0: UART1), %D2.L = buf先頭アドレス, %D3.L = 出力文字数
  12               	**     出力: %D0.L = 実際に送信した文字数 (1文字出力できるまでリトライ)
  13               	***************************************************************
  14               	outbyte:
  15               		* 破壊するレジスタ (%d0-%d3) をサブルーチン開始直後に退避 (4本 × 5バイ�
  16               		* 退避前の引数位置は 4(%sp) だったが、20バイト下がったため引数は 24(%sp)
  17               		* ビッグエンディアン(32bit拡張)の下位1バイトは 24 + 3 = 27(%sp) に格納され�
  18               	    * (32bitを4バイトに分けた時、最上位のbaseから4バイト目)
  19 0000 48E7 F080 		movem.l	%d0-%d3/%a0, -(%sp)
  20               		* 出力対象の1バイトを指すアドレスを %d2 にセット
  21 0004 41EF 001B 		lea	27(%sp), %a0
  22 0008 2408      	    move.l  %a0, %d2
  23               	    * レジスタ退避(4 * 5) + 引数位置4 + baseからのバイト3 = 23
  24               	
  25               	outbyte_retry:
  26 000a 7002      		move.l	#2, %d0                 | システムコール番号 2 = PUTSTRING
  27 000c 7200      		move.l	#0, %d1                 | ch = 0 (UART1)
  28 000e 7601      		move.l	#1, %d3                 | 出力文字数 = 1
  29 0010 4E40      		trap	#0                      | PUTSTRING システムコール呼び出し
  30               	
  31               		* 1文字送信できたか確認 (戻り値 %d0.L == 1 で完了、それ以外はリトライ)
  32 0012 0C80 0000 		cmpi.l	#1, %d0
  32      0001 
  33 0018 6600 FFF0 		bne	outbyte_retry
  34               	
  35               		* 退避したレジスタ (%d0-%d3) を復元して呼び出し元へ戻る
  36 001c 4CDF 010F 		movem.l	(%sp)+, %d0-%d3/%a0
  37 0020 4E75      		rts
